# Anthropic (Claude) - required for trend analysis
ANTHROPIC_API_KEY=your_key_here

# Reddit API - get free credentials at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=TrendScout/1.0

# Optional: Pinterest (uses web scraping if not set)
PINTEREST_ACCESS_TOKEN=

# Optional: RapidAPI key for social data endpoints
RAPIDAPI_KEY=
