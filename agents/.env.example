# Anthropic (Claude) - required for trend analysis
ANTHROPIC_API_KEY=your_key_here

# Reddit API - OPTIONAL
# Agent runs fine without this (covers Google Trends, TikTok, Pinterest, Etsy, Discord by default)
# If you want Reddit: https://www.reddit.com/prefs/apps → create "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendScout/1.0

# Optional: Discord bot token for direct channel monitoring
DISCORD_BOT_TOKEN=

# Optional: RapidAPI key for additional social data
RAPIDAPI_KEY=
