<!doctype html>
<html class="no-js" lang="{{- request.locale.iso_code -}}">
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<meta name="theme-color" content="{{- settings.color_button -}}">
		<meta name="format-detection" content="telephone=no">
		<meta name="google-site-verification" content="e6Cw6rCsQQr8nAzk3iyLRAGSr0VOvbOBhs7cbRQShxE" />
		<meta name="google-site-verification" content="luy7HwUAOhzzH3hMpzilF2OO0VZ_mzgAY05LcXrMOAg" />

		{%- if settings.hide_search_engine -%}
			<meta name="robots" content="noindex">
		{%- endif -%}

		<link rel="canonical" href="{{- canonical_url -}}">
		<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
		<link rel="preconnect" href="https://www.clarity.ms" crossorigin>
		<link rel="preconnect" href="https://shop.app" crossorigin>
				<link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
						<link rel="preconnect" href="https://monorail-edge.shopifysvc.com">
		<link rel="dns-prefetch" href="https://www.googletagmanager.com">
		<link rel="preload" as="font" type="font/woff2" href="https://aestheticrebellion.store/cdn/fonts/inter/inter_n4.b2a3f24c19b4de56e8871f609e73ca7f6d2e2bb9.woff2" crossorigin="anonymous">

		{%- if settings.favicon != blank -%}
			<link rel="icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
		{%- endif -%}

		{%- capture seo_title -%}
			{%- if template == 'search' and search.performed == true -%}
				{{ 'general.search.heading' | t: count: search.results_count }}: {{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
			{%- else -%}
				{{ page_title }}
			{%- endif -%}

			{%- if current_tags -%}
				{%- assign meta_tags = current_tags | join: ', ' -%} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
			{%- endif -%}

			{%- if current_page != 1 -%}
				&ndash; {{ 'general.meta.page' | t: page: current_page }}
			{%- endif -%}

			{%- assign escaped_page_title = page_title | escape -%}
			{%- unless escaped_page_title contains shop.name -%}
				&ndash; {{ shop.name }}
			{%- endunless -%}
		{%- endcapture -%}

		<title>
			{{- seo_title | strip -}}
		</title>

		{%- if page_description -%}
			<meta name="description" content="{{- page_description | escape -}}">
		{%- endif -%}

		{%- render 'head-theme-meta', layout: 'theme' -%}
		{%- render 'social-meta-tags' -%}

		{%- render 'custom-variables.css' -%}

		{%- render 'adastra' with '/src/styles/main.scss', preload: true -%}

		{%- if template.directory == 'customers' -%}
			<script src="{{- 'shopify_common.js' | shopify_asset_url -}}" defer="defer"></script>
		{%- endif -%}

		<script>
			window.themeCore = window.themeCore || {};
			window.themeCore.productPlaceholderImage = {%- if settings.product_default_image -%} {{- settings.product_default_image | img_url: "master" | replace: "//", "https://" | json -}} {%- else -%} null {%- endif -%};
			window.themeCore.productPlaceholderAspectRatio = {{ settings.product_default_image.aspect_ratio | json }};
			{% if settings.cart_reminder_enable %}
				window.themeCore.CartReminder = {
					config: {
						enableColorSchemeInheritance: {{- settings.enable_color_scheme_inheritance | json -}},
						colorSchemeLocal: "{{- settings.color_scheme | json -}}",
						colorSchemeGlobal: "{{- settings.main_color_scheme | json -}}",
						cookieTime: {{- settings.cart_reminder_cookie_time | json -}},
						displayFrequency: {{- settings.cart_reminder_display_frequency | json -}},
						text: {{- settings.cart_reminder_text | json -}},
						cartType: {{- settings.cart_type | json -}},
						cartRoute: {{- routes.cart_url | json -}},
						cartLinkA11y: {{- "cart.reminder.accessibility.cart" | t | escape | json -}},
						cartButtonA11y: {{- "cart.reminder.accessibility.cart_drawer" | t | escape | json -}},
						closeButtonA11y: {{- "cart.reminder.accessibility.close_button" | t | escape | json -}}
					}
				}
			{% endif %}
		</script>

		{%- render 'translations-methods' -%}
		{%- render 'translations' -%}

		{%- if tinyscript -%}{{ content_for_header }}{%- else -%}{% render 'tiny-script-control' %}{%- endif -%}

		<script>
			document.querySelector("html").classList.remove("no-js");
		</script>

		{{ 'brutalist-skin.css' | asset_url | stylesheet_tag }}
		{{ 'mosh-glitch.css' | asset_url | stylesheet_tag }}
		{%- comment -%}
			Per-page overrides, keyed off the `page-<handle>` body class below.
			Loaded last so it wins ties against the global skin.
		{%- endcomment -%}
		{{ 'ar-page-skin.css' | asset_url | stylesheet_tag }}
		{%- render 'structured-data-ar' -%}
	</head>

	{%- assign rtl_langs = 'ar,arc,dv,fa,ha,he,khw,ks,ku,ps,ur,yi' | split: ',' -%}
	{%- assign current_langs = localization.language.iso_code | split: '-' | first -%}

	{%- comment -%}
		`template-page` is identical for every page, so a second class carrying the
		handle is the only hook that lets one page be styled without hitting all of
		them. `page` is only defined on page templates, so this adds nothing
		elsewhere.
	{%- endcomment -%}
	<body class="template-{{ template | split: '.' | first }}{% if page %} page-{{ page.handle }}{% endif %}{% if rtl_langs contains current_langs %} rtl{% endif %}">
		<a href="#MainContent" class="skip-content-link visually-hidden">
			{{- "general.accessibility.skip_to_content" | t -}}
		</a>

		{%- sections 'header-group' -%}

		{%- render 'cl-sticky-search-bar' -%}

		{%- sections 'popup-group' -%}

		{%- if settings.enable_search -%}
			{%- render 'predictive-search' -%}
		{%- endif -%}

		<main id="MainContent" class="content" role="main" tabindex="-1">
			{%- if settings.show_breadcrumbs -%}
				{%- render "breadcrumbs" -%}
			{%- endif -%}

			{{ content_for_layout }}
		</main>

		{%- sections 'footer-group' -%}


		{%- render 'js-objects' -%}

		{%- render 'adastra' with '/src/styles/carousel.scss' -%}

		{%- render 'adastra' with '/src/styles/deferred-main.scss' -%}

		{% render 'js-animate-observer' %}

		{%- render 'adastra' with '/src/scripts/main.js' -%}

		{%- if settings.cart_reminder_enable -%}
			{%- render 'adastra' with '/src/styles/cart-reminder.scss' -%}
			{%- render 'adastra' with '/src/scripts/component-cart-reminder.js' -%}
		{%- endif -%}

		{%- render 'adastra' with '/src/scripts/component-ar-model.js' -%}
		{%- render 'ar-moshfit-trigger' -%}
		{%- render 'artist-drawer' -%}
		{%- render 'ar-newsletter-widget' -%}
		<script src="{{ 'mosh-fx.js' | asset_url }}" defer></script>
	</body>
</html>
