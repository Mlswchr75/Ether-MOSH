{% assign shipping_note = product.metafields.custom.shipping_note %}
{% if shipping_note != blank %}
<style>
  .br-shipping-note {
    background: #111;
    border-top: 3px solid #FF2BD6;
    border-bottom: 1px solid #222;
    padding: 1rem clamp(1rem, 4vw, 4rem);
  }
  .br-shipping-note__inner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 640px;
  }
  .br-shipping-note__icon {
    font-size: 1.25rem;
    flex-shrink: 0;
    line-height: 1.4;
  }
  .br-shipping-note__body {
    flex: 1;
  }
  .br-shipping-note__label {
    display: block;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #FF2BD6;
    margin-bottom: 0.3rem;
    font-weight: 700;
  }
  .br-shipping-note__text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: #ccc;
    margin: 0;
  }
</style>

<div class="br-shipping-note">
  <div class="br-shipping-note__inner">
    <span class="br-shipping-note__icon">🚚</span>
    <div class="br-shipping-note__body">
      <span class="br-shipping-note__label">// Shipping &amp; Fulfillment</span>
      <p class="br-shipping-note__text">{{ shipping_note }}</p>
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Shipping Note",
  "tag": "section",
  "class": "section-shipping-note"
}
{% endschema %}
