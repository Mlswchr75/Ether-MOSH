{{ 'brutalist-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'brutalist-showcase.js' | asset_url }}" defer></script>
<script src="{{ 'brutalist-random.js' | asset_url }}" defer></script>

<style>
  /* Fix: first-row rotated cards need top clearance so corners are never cropped */
  .section-brutalist-random,
  .section-brutalist-random .br-showcase {
    overflow: visible !important;
  }
  .section-brutalist-random .br-showcase__grid {
    overflow: visible !important;
    padding-top: 2.5rem;
  }
  /* Neutralise any Allure section-animate / js-animate displacement on this section */
  .section-brutalist-random.section-animate,
  .section-brutalist-random.js-animate {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
</style>

{%- liquid
  assign cols_d = section.settings.cols_desktop
  assign cols_m = section.settings.cols_mobile
  assign gap = section.settings.gap
  assign bg = section.settings.bg_color
  assign fg = section.settings.fg_color
  assign accent = section.settings.accent_color
  assign aspect = section.settings.card_aspect
  assign initial_count = section.settings.initial_count
  assign max_total = section.settings.max_total
  assign shuffle = section.settings.shuffle
  assign cycle_speed = section.settings.cycle_speed
  assign src_collection = section.settings.source_collection
-%}

{%- if src_collection != blank -%}
  {%- assign coll = collections[src_collection] -%}
{%- else -%}
  {%- assign coll = collections.all -%}
{%- endif -%}

<section
  class="br-showcase br-random"
  style="--br-bg:{{ bg }};--br-fg:{{ fg }};--br-accent:{{ accent }};--br-gap:{{ gap }}px;--br-cols-d:{{ cols_d }};--br-cols-m:{{ cols_m }};--br-aspect:{{ aspect }};"
  data-section-id="{{ section.id }}"
  data-shuffle="{% if shuffle %}1{% else %}0{% endif %}"
  data-cycle-speed="{{ cycle_speed }}"
  data-collection-handle="{{ src_collection | default: 'all' }}"
  data-max-total="{{ max_total }}"
  data-currency="{{ shop.currency }}"
>

  <svg width="0" height="0" style="position:absolute;pointer-events:none" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="{{ section.id }}-br-frame-1" clipPathUnits="objectBoundingBox"><polygon points="0.02,0.06 0.15,0.01 0.34,0.04 0.52,0.00 0.74,0.03 0.92,0.02 0.99,0.18 0.97,0.41 0.99,0.62 0.96,0.85 0.93,0.99 0.71,0.96 0.50,0.99 0.28,0.97 0.07,0.99 0.01,0.81 0.04,0.60 0.00,0.38 0.03,0.21"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-2" clipPathUnits="objectBoundingBox"><polygon points="0.00,0.14 0.08,0.03 0.27,0.00 0.46,0.06 0.63,0.01 0.81,0.04 0.96,0.00 1.00,0.21 0.96,0.39 1.00,0.57 0.97,0.78 1.00,0.94 0.83,0.97 0.61,1.00 0.40,0.96 0.18,1.00 0.02,0.95 0.05,0.74 0.00,0.52 0.04,0.33"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-3" clipPathUnits="objectBoundingBox"><polygon points="0.06,0.02 0.24,0.05 0.42,0.00 0.61,0.03 0.79,0.01 0.95,0.04 0.98,0.22 0.94,0.45 0.99,0.66 0.97,0.88 0.86,0.96 0.66,0.99 0.45,0.94 0.24,0.98 0.05,0.95 0.02,0.76 0.06,0.55 0.01,0.34 0.04,0.16"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-4" clipPathUnits="objectBoundingBox"><polygon points="0.03,0.10 0.18,0.00 0.36,0.07 0.55,0.02 0.71,0.05 0.88,0.00 0.97,0.14 1.00,0.33 0.95,0.51 1.00,0.71 0.94,0.91 0.78,1.00 0.57,0.95 0.36,0.99 0.15,0.93 0.00,0.86 0.06,0.66 0.02,0.46 0.07,0.27"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-5" clipPathUnits="objectBoundingBox"><polygon points="0.00,0.04 0.21,0.02 0.39,0.06 0.58,0.00 0.77,0.03 0.94,0.01 1.00,0.20 0.96,0.42 1.00,0.61 0.95,0.83 0.97,0.97 0.76,0.94 0.55,0.99 0.33,0.95 0.11,0.99 0.03,0.83 0.00,0.62 0.05,0.42 0.01,0.22"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-6" clipPathUnits="objectBoundingBox"><polygon points="0.04,0.07 0.22,0.04 0.41,0.01 0.60,0.05 0.78,0.00 0.96,0.06 0.99,0.27 0.95,0.48 0.98,0.69 0.94,0.89 0.81,0.97 0.61,1.00 0.41,0.97 0.21,1.00 0.04,0.96 0.01,0.79 0.05,0.59 0.00,0.40 0.03,0.22"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-7" clipPathUnits="objectBoundingBox"><polygon points="0.07,0.00 0.26,0.04 0.45,0.02 0.65,0.06 0.84,0.01 1.00,0.10 0.97,0.30 1.00,0.50 0.96,0.71 1.00,0.92 0.84,1.00 0.62,0.96 0.41,1.00 0.20,0.96 0.02,1.00 0.00,0.80 0.04,0.59 0.00,0.39 0.03,0.18"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-8" clipPathUnits="objectBoundingBox"><polygon points="0.02,0.18 0.10,0.05 0.30,0.00 0.48,0.04 0.67,0.00 0.86,0.03 0.99,0.08 0.96,0.28 1.00,0.49 0.95,0.69 1.00,0.89 0.88,0.99 0.68,0.94 0.47,0.99 0.27,0.96 0.07,1.00 0.00,0.84 0.04,0.63 0.00,0.43 0.03,0.27"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-9" clipPathUnits="objectBoundingBox"><polygon points="0.05,0.04 0.20,0.00 0.40,0.03 0.59,0.00 0.79,0.05 0.97,0.00 1.00,0.19 0.97,0.40 1.00,0.61 0.96,0.81 0.91,0.99 0.71,0.95 0.50,0.99 0.30,0.94 0.10,0.98 0.00,0.78 0.05,0.58 0.00,0.37 0.04,0.16"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-10" clipPathUnits="objectBoundingBox"><polygon points="0.00,0.09 0.16,0.02 0.35,0.05 0.53,0.00 0.72,0.04 0.91,0.00 1.00,0.16 0.95,0.36 0.99,0.56 0.94,0.77 1.00,0.96 0.79,0.98 0.58,0.94 0.37,1.00 0.16,0.95 0.00,1.00 0.03,0.80 0.00,0.59 0.06,0.39 0.01,0.24"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-11" clipPathUnits="objectBoundingBox"><polygon points="0.03,0.03 0.23,0.06 0.43,0.02 0.62,0.05 0.81,0.00 0.99,0.08 0.96,0.27 1.00,0.46 0.97,0.66 1.00,0.86 0.86,0.99 0.66,0.96 0.46,1.00 0.27,0.97 0.06,1.00 0.00,0.82 0.05,0.62 0.00,0.42 0.04,0.21"/></clipPath>
      <clipPath id="{{ section.id }}-br-frame-12" clipPathUnits="objectBoundingBox"><polygon points="0.06,0.05 0.27,0.00 0.46,0.04 0.65,0.00 0.84,0.06 1.00,0.04 0.97,0.24 1.00,0.45 0.95,0.65 1.00,0.85 0.88,0.97 0.67,1.00 0.46,0.94 0.25,1.00 0.04,0.97 0.00,0.77 0.04,0.57 0.00,0.36 0.05,0.18"/></clipPath>
    </defs>
  </svg>

  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <header class="br-showcase__header">
      {%- if section.settings.subheading != blank -%}
        <p class="br-showcase__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="br-showcase__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="br-showcase__grid" data-br-random-grid>
    {%- comment -%} Liquid hard-caps `for product in collection.products` at 50. The JS handles the rest via AJAX. {%- endcomment -%}
    {%- for product in coll.products limit: 50 -%}
      {%- assign idx = forloop.index0 -%}

      {%- comment -%} Look for a per-product override block {%- endcomment -%}
      {%- assign ov_video = null -%}
      {%- assign ov_accent = blank -%}
      {%- assign ov_frame = 0 -%}
      {%- assign ov_rot = 0 -%}
      {%- assign ov_caption = blank -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.product.id == product.id -%}
          {%- assign ov_video = block.settings.hover_video -%}
          {%- assign ov_accent = block.settings.accent_override -%}
          {%- assign ov_frame = block.settings.frame_override -%}
          {%- assign ov_rot = block.settings.rotation_override -%}
          {%- assign ov_caption = block.settings.caption -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- assign frame_n = ov_frame -%}
      {%- if frame_n == 0 -%}
        {%- assign frame_n = idx | modulo: 12 | plus: 1 -%}
      {%- endif -%}
      {%- assign rot_raw = idx | times: 137 | modulo: 11 -%}
      {%- assign rot = rot_raw | minus: 5 -%}
      {%- if ov_rot != 0 -%}
        {%- assign rot = ov_rot -%}
      {%- endif -%}
      {%- assign card_accent = ov_accent | default: accent -%}
      {%- assign card_caption = ov_caption | default: product.title -%}

      {%- assign is_eager = false -%}
      {%- if forloop.index <= initial_count -%}
        {%- assign is_eager = true -%}
      {%- endif -%}

      {%- render 'brutalist-frame-cycler',
          product: product,
          frame_n: frame_n,
          rot: rot,
          accent: card_accent,
          idx: idx,
          hover_video: ov_video,
          caption: card_caption,
          eager: is_eager,
          section_sid: section.id
      -%}
    {%- endfor -%}
  </div>

  <div class="br-loadmore-wrap" data-br-loadmore-wrap style="display:none">
    <button type="button" class="br-loadmore-btn" data-br-loadmore>
      <span data-br-loadmore-text>LOAD MORE</span>
    </button>
  </div>

</section>

{% schema %}
{
  "name": "Brutalist Random Products",
  "tag": "section",
  "class": "section-brutalist-random",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "RANDOM PRODUCTS" },
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "// PICK YOUR WEAPON" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "fg_color", "label": "Foreground", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Default accent", "default": "#FF2BD6" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "cols_desktop", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "cols_mobile", "label": "Mobile columns", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "gap", "label": "Gap (px)", "min": 8, "max": 80, "step": 4, "default": 32 },
    { "type": "select", "id": "card_aspect", "label": "Card aspect", "options": [
      { "value": "1 / 1", "label": "Square" },
      { "value": "4 / 5", "label": "Portrait 4:5" },
      { "value": "3 / 4", "label": "Portrait 3:4" },
      { "value": "2 / 3", "label": "Portrait 2:3" },
      { "value": "16 / 9", "label": "Landscape 16:9" }
    ], "default": "4 / 5" },
    { "type": "header", "content": "Source" },
    { "type": "collection", "id": "source_collection", "label": "Source collection (leave empty for ALL products)" },
    { "type": "range", "id": "max_total", "label": "Max products to render (server + AJAX combined)", "min": 50, "max": 500, "step": 50, "default": 100 },
    { "type": "header", "content": "Performance" },
    { "type": "paragraph", "content": "Only the first N cards load their images immediately. The rest stream in after the page finishes loading, then as the visitor scrolls." },
    { "type": "range", "id": "initial_count", "label": "Initial visible / eagerly-loaded", "min": 4, "max": 36, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "shuffle", "label": "Shuffle product order on each page load", "default": true },
    { "type": "header", "content": "Image cycling" },
    { "type": "paragraph", "content": "Hover (mouse) auto-cycles through a product's images. Pan / move horizontally to manually scrub. Pause / hold for a moment to resume auto-cycling." },
    { "type": "range", "id": "cycle_speed", "label": "Auto-cycle speed (ms per image)", "min": 250, "max": 1500, "step": 50, "default": 700 }
  ],
  "blocks": [
    {
      "type": "product_override",
      "name": "Product override",
      "settings": [
        { "type": "paragraph", "content": "Pick a product to override. If a hover video is set, that product card will play the video on hover instead of cycling through its images." },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "video", "id": "hover_video", "label": "Hover video (replaces image cycling)" },
        { "type": "text", "id": "caption", "label": "Caption override" },
        { "type": "color", "id": "accent_override", "label": "Accent color override" },
        { "type": "range", "id": "frame_override", "label": "Frame shape (0 = auto)", "min": 0, "max": 12, "step": 1, "default": 0 },
        { "type": "range", "id": "rotation_override", "label": "Rotation deg (0 = auto)", "min": -8, "max": 8, "step": 1, "default": 0 }
      ]
    }
  ],
  "presets": [
    { "name": "Brutalist Random Products" }
  ]
}
{% endschema %}
