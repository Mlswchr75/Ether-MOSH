{%- comment -%}
  Single product card for the random-products section.
  Auto-detects video from product.media — if the product's first media video exists,
  it plays on hover instead of cycling images.
  params: product, frame_n, rot, accent, idx, caption, eager (bool)
  hover_video: optional explicit override (legacy / manual use)

  Patched 2026-06-10:
  - deferred imgs use loading="eager" + fetchpriority="low" (src only injected on
    activation, so no upfront cost — but once activated the image loads instantly
    instead of idling in Chrome's low-priority lazy queue).
  - FIXED broken script close: the JSON images block previously ended with a
    literal <\/script> (backslash included), which never closes the tag in HTML
    and swallowed the markup of neighboring cards. Now closes properly.
{%- endcomment -%}

{%- assign clip_id = 'br-frame-' | append: frame_n -%}
{%- if section_sid != blank -%}{%- assign clip_id = section_sid | append: '-' | append: clip_id -%}{%- endif -%}

{%- comment -%} Detect video: explicit override first, then auto-detect from product.media {%- endcomment -%}
{%- assign has_video = false -%}
{%- assign product_video = null -%}
{%- if hover_video != blank and hover_video != null -%}
  {%- if hover_video.media_type == 'video' -%}
    {%- assign has_video = true -%}
    {%- assign product_video = hover_video -%}
  {%- endif -%}
{%- else -%}
  {%- for media in product.media -%}
    {%- if media.media_type == 'video' -%}
      {%- assign has_video = true -%}
      {%- assign product_video = media -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign first_image = product.featured_image -%}
{%- assign cycle_images = product.images -%}

{%- if product.price_varies -%}
  {%- assign price_label = product.price_min | money -%}
  {%- assign price_prefix = 'FROM ' -%}
{%- else -%}
  {%- assign price_label = product.price | money -%}
  {%- assign price_prefix = '' -%}
{%- endif -%}

<article
  class="br-card{% unless has_video %} br-card--cycler{% endunless %}{% unless eager %} br-card--deferred{% endunless %}"
  style="--br-rot:{{ rot }}deg;--br-clip:url(#{{ clip_id }});--br-accent-card:{{ accent }};"
  data-idx="{{ idx }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  {% if has_video %}data-has-video="true"{% endif %}
>
  <a class="br-card__link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    <div class="br-card__frame" {% unless has_video %}data-cycler{% endunless %}>
      {%- if first_image != blank -%}
        {%- if eager -%}
          <img
            class="br-card__media br-card__still br-card__cycle-img"
            src="{{ first_image | image_url: width: 800 }}"
            srcset="{{ first_image | image_url: width: 400 }} 400w, {{ first_image | image_url: width: 800 }} 800w, {{ first_image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 750px) 50vw, 25vw"
            alt="{{ product.title | escape }}"
            loading="eager"
            decoding="async"
            data-cycle-index="0"
          >
        {%- else -%}
          <img
            class="br-card__media br-card__still br-card__cycle-img"
            data-src="{{ first_image | image_url: width: 800 }}"
            data-srcset="{{ first_image | image_url: width: 400 }} 400w, {{ first_image | image_url: width: 800 }} 800w, {{ first_image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 750px) 50vw, 25vw"
            alt="{{ product.title | escape }}"
            loading="eager"
            fetchpriority="low"
            decoding="async"
            data-cycle-index="0"
          >
        {%- endif -%}

        {%- unless has_video -%}
          <script type="application/json" class="br-card__images-data" data-br-images>[
            {%- for img in cycle_images -%}
              "{{ img | image_url: width: 800 }}"{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]</script>
        {%- endunless -%}
      {%- else -%}
        <div class="br-card__media br-card__still br-card__placeholder" aria-hidden="true"></div>
      {%- endif -%}

      {%- if has_video and product_video != null -%}
        <video
          class="br-card__media br-card__hover br-card__hover--video"
          muted
          playsinline
          loop
          preload="none"
          data-hover
          aria-hidden="true"
          {%- if product_video.preview_image -%}
          poster="{{ product_video.preview_image | image_url: width: 600 }}"
          {%- endif -%}
        >
          {%- for src in product_video.sources -%}
            <source data-src="{{ src.url }}" type="{{ src.mime_type }}">
          {%- endfor -%}
        </video>
      {%- endif -%}

      {%- comment -%}
        Quick-view hot zone: the middle 30% of the frame. Pointer-only
        affordance (aria-hidden / not focusable) — keyboard and screen-reader
        users still get the full product page via .br-card__link, so no
        functionality is gated behind it.
      {%- endcomment -%}
      <span class="br-card__qv" data-br-qv data-product-handle="{{ product.handle }}" aria-hidden="true">
        <span class="br-card__qv-eye"></span>
      </span>
    </div>

    {%- if product.price != nil -%}
      <span class="br-card__price" aria-label="Price {{ price_prefix }}{{ price_label | strip_html }}">
        {%- if price_prefix != '' -%}<span class="br-card__price-prefix">{{ price_prefix }}</span>{%- endif -%}
        {{ price_label }}
      </span>
    {%- endif -%}

    {%- if caption != blank -%}
      <div class="br-card__caption">
        <span class="br-card__caption-text">{{ caption | escape }}</span>
      </div>
    {%- endif -%}
  </a>
</article>
