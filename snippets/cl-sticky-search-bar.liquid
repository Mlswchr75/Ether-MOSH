{%- comment -%}
	------------------------------------------------------------------------------
	Snippet: CL sticky search bar

	Rendered from layout/theme.liquid immediately after the header group. The
	inline script below then relocates the element INTO the <header>, directly
	after .header__container, while the page is still parsing (no flash).

	Why: the header is configured with a transparent overlay on the homepage and
	collection pages, so it is taken out of normal flow. A separately-positioned
	sticky bar sitting at the top of the flow ends up underneath the header and,
	with a higher z-index, paints over the nav row ("Shop All / Guys / Girls").
	Living inside the header removes the whole class of overlap problems and
	makes the bar inherit the header's own sticky behaviour.

	The "Browse" chips are rendered here rather than in JS on purpose: they are
	real collection links with real counts, so they work before the script loads,
	they are crawlable, and they can never drift out of sync with the store.
	------------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign browse_max = 8
  assign skip_handles = 'all-products,frontpage,'
  assign ranked = collections | sort: 'all_products_count' | reverse
-%}

<div class="cl-sticky-search" id="cl-sticky-search"
     data-qv-css="{{ 'brutalist-quickview.css' | asset_url }}"
     data-qv-js="{{ 'brutalist-quickview.js' | asset_url }}">
  <div class="cl-sticky-search__wrap">
    <div class="cl-sticky-search__inner">
      <div class="cl-sticky-search__input-wrap">
        <span class="cl-sticky-search__icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M11 11L14.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
        <div class="cl-sticky-search__field">
          <input
            type="text"
            id="cl-search-input"
            class="cl-sticky-search__input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-controls="cl-search-dropdown"
            aria-label="{{- 'layout.navigation.search' | t | escape -}}"
          >
          <span class="cl-sticky-search__placeholder" id="cl-placeholder" aria-hidden="true"></span>
        </div>
        <span class="cl-sticky-search__hint" aria-hidden="true">/</span>
        <button class="cl-sticky-search__clear" id="cl-search-clear" aria-label="Clear search" type="button" style="display:none">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="cl-search-dropdown" id="cl-search-dropdown" role="listbox"
         aria-label="Search suggestions" hidden>

      <div class="cl-search-section" id="cl-recent-section" hidden>
        <div class="cl-search-label">Recent</div>
        <div class="cl-search-chips" id="cl-recent-chips"></div>
      </div>

      <div class="cl-search-section" id="cl-browse-section">
        <div class="cl-search-label">Browse</div>
        <div class="cl-search-chips">
          {%- assign shown = 0 -%}
          {%- for cl_col in ranked -%}
            {%- if shown >= browse_max -%}{%- break -%}{%- endif -%}
            {%- assign needle = cl_col.handle | append: ',' -%}
            {%- unless skip_handles contains needle or cl_col.all_products_count < 5 -%}
              <a class="cl-search-chip" data-nav role="option" href="{{ cl_col.url }}">
                {{- cl_col.title | escape -}}
                <span class="cl-search-chip__n">{{ cl_col.all_products_count }}</span>
              </a>
              {%- assign shown = shown | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="cl-search-section" id="cl-results-section" hidden>
        <div class="cl-search-results" id="cl-search-results"></div>
      </div>
    </div>
  </div>
</div>

<script>
	(function () {
		var bar = document.getElementById("cl-sticky-search");

		if (!bar) {
			return;
		}

		var header = document.querySelector("header.header") || document.querySelector(".js-header");
		var container = header && header.querySelector("[data-header-container]");

		if (container && container.parentNode) {
			container.parentNode.insertBefore(bar, container.nextSibling);
		}
	})();
</script>

{{ 'cl-sticky-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cl-sticky-search.js' | asset_url }}" defer></script>
